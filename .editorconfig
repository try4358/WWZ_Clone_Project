# 최상위 설정 파일. 상위 폴더의 .editorconfig는 더 이상 탐색하지 않음
root = true

# 모든 파일에 공통 적용
[*]
# UTF-8 BOM: 언리얼/Visual Studio가 한글 주석이 포함된 소스를 올바른 인코딩으로 인식하도록 함
charset = utf-8-bom
# Windows 기준 줄바꿈(CRLF): 팀원 간 줄바꿈 차이로 생기는 불필요한 diff 방지
end_of_line = crlf
# 파일 끝에 빈 줄 추가: 마지막 줄 관련 diff 경고 방지
insert_final_newline = true
# 줄 끝 공백 제거: 의미 없는 공백 변경이 커밋에 섞이는 것을 방지
trim_trailing_whitespace = true

# 언리얼 C++ 소스(.cpp, .h)와 C# 빌드 스크립트(*.Build.cs, *.Target.cs) 대상
[*.{cpp,h,cs}]
# 들여쓰기는 탭이 아닌 공백 사용
indent_style = space
# 들여쓰기 한 단계 = 공백 4칸
indent_size = 4