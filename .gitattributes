# ============================================================
# 줄바꿈 처리
# ============================================================
# 텍스트 파일은 Git이 줄바꿈을 자동 판단 (LFS 대상 바이너리는 아래에서 -text로 별도 지정)
* text=auto
# 셸 스크립트는 CRLF면 Linux/Mac(CI, 빌드 서버)에서 실행 오류가 나므로 LF 고정
*.sh text eol=lf
# 배치 파일은 Windows 전용이므로 CRLF 고정
*.bat text eol=crlf
*.cmd text eol=crlf

# ============================================================
# Git LFS 설정
# ============================================================
# 용량이 크거나 텍스트 비교/병합이 불가능한 바이너리는 Git LFS로 관리
# -text : 줄바꿈 변환 방지 (바이너리 손상 방지)
# 처음 사용하는 PC에서는 `git lfs install`을 한 번 실행해야 함

# ------------------------------------------------------------
# Unreal Engine 에셋
# ------------------------------------------------------------
# 에셋(.uasset), 레벨(.umap), 에셋 분리 데이터(.uexp, .ubulk)
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
*.uexp filter=lfs diff=lfs merge=lfs -text
*.ubulk filter=lfs diff=lfs merge=lfs -text

# ------------------------------------------------------------
# 3D 모델
# ------------------------------------------------------------
# FBX(애니메이션 포함), Autodesk 3DS, Wavefront OBJ
*.fbx filter=lfs diff=lfs merge=lfs -text
*.3ds filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
# DCC 툴 원본 파일
*.blend filter=lfs diff=lfs merge=lfs -text
*.ma filter=lfs diff=lfs merge=lfs -text
*.mb filter=lfs diff=lfs merge=lfs -text
*.max filter=lfs diff=lfs merge=lfs -text

